@page "/ogrenci-sicil"
@inject IJSRuntime JS
@using System.Text.Json

<div class="container mt-4">
    <h2 class="mb-4">📘 Öğrenci Disiplin Sicili</h2>

    <!-- FİLTRE -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label>Sınıf</label>
                    <select class="form-select" @bind="FiltreSinif">
                        <option value="">Tümü</option>
                        <option>9</option><option>10</option>
                        <option>11</option><option>12</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label>Şube</label>
                    <select class="form-select" @bind="FiltreSube">
                        <option value="">Tümü</option>
                        <option>A</option><option>B</option>
                        <option>C</option><option>D</option>
                        <option>E</option>
                        <option>F</option>
                        <option>G</option>
                        <option>H</option>

                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label>Öğrenci Adı</label>
                    <input class="form-control"
                           placeholder="Ad Soyad yaz"
                           @bind="FiltreOgrenci" />
                </div>
            </div>
        </div>
    </div>

    <!-- SİCİL TABLOSU -->
    @if (!FiltreliSicil.Any())
    {
        <div class="alert alert-info">
            Seçilen kriterlere ait sicil kaydı bulunamadı.
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Öğrenci</th>
                    <th>Sınıf</th>
                    <th>Disiplin Türü</th>
                    <th>Açıklama</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in FiltreliSicil)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.OgrenciAdi</td>
                        <td>@s.Sinif/@s.Sube</td>
                        <td>
                            <span class="badge bg-danger">
                                @s.Tur
                            </span>
                        </td>
                        <td>@s.Aciklama</td>
                        <td>@s.Tarih.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-danger"
                onclick="window.print()">
            📄 Sicil Belgesi (PDF)
        </button>
    }
</div>
@code {

    class DisiplinViewModel
    {
        public int Id { get; set; }
        public string OgrenciAdi { get; set; }
        public string Sinif { get; set; }
        public string Sube { get; set; }
        public string Tur { get; set; }
        public string Aciklama { get; set; }
        public string Durum { get; set; }
        public DateTime Tarih { get; set; }   // ✅ EKLENDİ
    }

    class DataModel
    {
        public List<DisiplinViewModel> Kayitlar { get; set; } = new();
        public List<DisiplinViewModel> Sicil { get; set; } = new();
    }

    List<DisiplinViewModel> Sicil = new();

    // ✅ HTML ile AYNI İSİMLER
    string FiltreSinif = "";
    string FiltreSube = "";
    string FiltreOgrenci = "";

   bool _yuklendi = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_yuklendi)
        {
            _yuklendi = true;

            var json = await JS.InvokeAsync<string>(
                "localStorage.getItem", "disiplinData");

            if (!string.IsNullOrEmpty(json))
            {
                var data = JsonSerializer.Deserialize<DataModel>(json);
                Sicil = data?.Sicil ?? new();
                StateHasChanged(); // 🔴 ÇOK ÖNEMLİ
            }
        }
    }

    IEnumerable<DisiplinViewModel> FiltreliSicil =>
        Sicil.Where(x =>
            (string.IsNullOrEmpty(FiltreSinif) || x.Sinif == FiltreSinif) &&
            (string.IsNullOrEmpty(FiltreSube) || x.Sube == FiltreSube) &&
            (string.IsNullOrWhiteSpace(FiltreOgrenci) ||
             x.OgrenciAdi.Contains(FiltreOgrenci, StringComparison.OrdinalIgnoreCase))
        );
}
