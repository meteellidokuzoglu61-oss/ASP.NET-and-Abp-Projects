@page "/dilekce"

<div class="container mt-4">
    <h2 class="mb-4">📄 Dilekçe İşlemleri</h2>

    <!-- YENİ DİLEKÇE -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Yeni Dilekçe Oluştur</h5>

            <div class="mb-3">
                <label class="form-label">Öğrenci Adı Soyadı</label>
                <input class="form-control" @bind="YeniDilekce.OgrenciAdi" />
            </div>

            <div class="mb-3">
                <label class="form-label">Dilekçe Türü</label>
                <select class="form-select" @bind="YeniDilekce.Tur">
                    <option value="">Seçiniz</option>
                    <option>Öğrenci Belgesi Talebi</option>
                    <option>İzin Dilekçesi</option>
                    <option>Ders Muafiyet Talebi</option>
                    <option>Kayıt Dondurma</option>
                    <option>Diğer</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Konu</label>
                <input class="form-control" @bind="YeniDilekce.Konu" />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea class="form-control" rows="4" @bind="YeniDilekce.Aciklama"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="DilekceGonder">
                Gönder
            </button>
        </div>
    </div>

    <!-- DİLEKÇE GEÇMİŞİ -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">📂 Dilekçe Geçmişi</h5>

            @if (!Dilekceler.Any())
            {
                <div class="alert alert-info">
                    Henüz dilekçe bulunmamaktadır.
                </div>
            }
            else
            {
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Öğrenci</th>
                            <th>Tür</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Dilekceler)
                        {
                            <tr>
                                <td>@d.Id</td>
                                <td>@d.OgrenciAdi</td>
                                <td>@d.Tur</td>
                                <td>@d.Konu</td>
                                <td>@d.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (d.Durum == "İnceleniyor")
                                    {
                                        <span class="badge bg-warning">İnceleniyor</span>
                                    }
                                    else if (d.Durum == "Onaylandı")
                                    {
                                        <span class="badge bg-success">Onaylandı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Reddedildi</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-success btn-sm me-1"
                                            @onclick="@(() => DurumDegistir(d, "Onaylandı"))">
                                        ✔
                                    </button>

                                    <button class="btn btn-danger btn-sm me-1"
                                            @onclick="@(() => DurumDegistir(d, "Reddedildi"))">
                                        ✖
                                    </button>

                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="@(() => DilekceSil(d))">
                                        🗑
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {

    class DilekceViewModel
    {
        public int Id { get; set; }
        public string OgrenciAdi { get; set; }
        public string Tur { get; set; }
        public string Konu { get; set; }
        public string Aciklama { get; set; }
        public DateTime Tarih { get; set; }
        public string Durum { get; set; } = "İnceleniyor";
    }

    DilekceViewModel YeniDilekce = new();
    List<DilekceViewModel> Dilekceler = new();
    int Sayac = 1;

    void DilekceGonder()
    {
        if (string.IsNullOrWhiteSpace(YeniDilekce.OgrenciAdi) ||
            string.IsNullOrWhiteSpace(YeniDilekce.Tur) ||
            string.IsNullOrWhiteSpace(YeniDilekce.Konu))
        {
            return;
        }

        Dilekceler.Insert(0, new DilekceViewModel
        {
            Id = Sayac++,
            OgrenciAdi = YeniDilekce.OgrenciAdi,
            Tur = YeniDilekce.Tur,
            Konu = YeniDilekce.Konu,
            Aciklama = YeniDilekce.Aciklama,
            Tarih = DateTime.Now,
            Durum = "İnceleniyor"
        });

        YeniDilekce = new();
    }

    void DurumDegistir(DilekceViewModel dilekce, string durum)
    {
        dilekce.Durum = durum;
    }

    void DilekceSil(DilekceViewModel dilekce)
    {
        Dilekceler.Remove(dilekce);
    }
}
