@page "/alanlar"

<div class="container mt-4">
    <h2 class="text-center mb-4">Alanlarımız, Bölümlerimiz ve Dalları</h2>

    <div class="accordion" id="alanAccordion">

        <!-- BİLİŞİM -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#bilisim">
                    💻 Bilişim Teknolojileri Alanı
                </button>
            </h2>
            <div id="bilisim" class="accordion-collapse collapse show">
                <div class="accordion-body">

                    <p>
                        Yazılım, donanım ve ağ sistemleri alanlarında modern bilişim eğitimi verilir.
                    </p>

                    <strong>Yazılım Bölümü</strong>
                    <ul>
                        <li>Yazılım Geliştirme</li>
                        <li>Web Programcılığı</li>
                        <li>Mobil Uygulama Geliştirme</li>
                    </ul>

                    <strong>Ağ ve Sistem Bölümü</strong>
                    <ul>
                        <li>Ağ İşletmenliği</li>
                        <li>Sunucu Sistemleri</li>
                        <li>Siber Güvenlik Temelleri</li>
                    </ul>

                </div>
            </div>
        </div>

        <!-- ELEKTRİK ELEKTRONİK -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#elektrik">
                    ⚡ Elektrik - Elektronik Teknolojisi Alanı
                </button>
            </h2>
            <div id="elektrik" class="accordion-collapse collapse">
                <div class="accordion-body">

                    <p>
                        Elektrik tesisatları, elektronik devreler ve kontrol sistemleri üzerine eğitim verilir.
                    </p>

                    <strong>Elektrik Bölümü</strong>
                    <ul>
                        <li>Elektrik Tesisatları</li>
                        <li>Pano Montajı</li>
                        <li>Enerji Dağıtım Sistemleri</li>
                    </ul>

                    <strong>Elektronik Bölümü</strong>
                    <ul>
                        <li>Elektronik Devreler</li>
                        <li>Güvenlik Sistemleri</li>
                        <li>Endüstriyel Elektronik</li>
                    </ul>

                </div>
            </div>
        </div>

        <!-- MAKİNE VE TASARIM -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#makine">
                    🛠️ Makine ve Tasarım Teknolojisi Alanı
                </button>
            </h2>
            <div id="makine" class="accordion-collapse collapse">
                <div class="accordion-body">

                    <p>
                        İmalat, üretim ve bilgisayar destekli tasarım alanlarında eğitim verilir.
                    </p>

                    <strong>Makine İmalat Bölümü</strong>
                    <ul>
                        <li>Torna - Freze</li>
                        <li>CNC Tezgâhları</li>
                        <li>Kaynak Teknolojisi</li>
                    </ul>

                    <strong>Tasarım Bölümü</strong>
                    <ul>
                        <li>Bilgisayar Destekli Tasarım (CAD)</li>
                        <li>Teknik Resim</li>
                        <li>Ürün Tasarımı</li>
                    </ul>

                </div>
            </div>
        </div>

        <!-- ENDÜSTRİYEL OTOMASYON -->
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#otomasyon">
                    🤖 Endüstriyel Otomasyon Teknolojileri Alanı
                </button>
            </h2>
            <div id="otomasyon" class="accordion-collapse collapse">
                <div class="accordion-body">

                    <p>
                        Otomatik kontrol, PLC ve robotik sistemler üzerine uygulamalı eğitim verilir.
                    </p>

                    <strong>Otomasyon Sistemleri Bölümü</strong>
                    <ul>
                        <li>PLC Programlama</li>
                        <li>SCADA Sistemleri</li>
                        <li>Endüstriyel Kontrol</li>
                    </ul>

                    <strong>Robotik Sistemler Bölümü</strong>
                    <ul>
                        <li>Endüstriyel Robotlar</li>
                        <li>Sensör ve Aktüatörler</li>
                        <li>Akıllı Üretim Sistemleri</li>
                    </ul>

                </div>
            </div>
        </div>

    </div>
</div>
