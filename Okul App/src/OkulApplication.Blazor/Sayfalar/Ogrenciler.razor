@page "/students"
@using Volo.Abp.Application.Dtos
@using OkulApplication.Ogrenciler
@using OkulApplication.Localization
@attribute [Authorize(OkulApplicationPermissions.Ogrenciler.Default)]
@using OkulApplication.Permissions
@inherits AbpCrudPageBase<OgrenciAppService, OgrenciDto, Guid, PagedAndSortedResultRequestDto, CreateUpdateOgrenciDto>

<Card>
    <CardHeader>
        <h2>@L["Öğrenciler"]</h2>
    </CardHeader>

    <CardBody>
        <DataGrid TItem="OgrenciDto"
                  Data="Entities"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  PageSize="PageSize">

            <DataGridColumns>

                <!-- Ad Soyad -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.Ogrenci_AdiSoyadi)"
                                Caption="@L["Ad-Soyad"]" />

                <!-- Bölüm -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.Ogrenci_Bolumu)"
                                Caption="@L["Bölüm"]">
                    <DisplayTemplate>
                        @L[$"Enum:Bolum.{context.Ogrenci_Bolumu}"]
                    </DisplayTemplate>
                </DataGridColumn>

                <!-- Doğum Tarihi -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.Ogrenci_DogumTarihi)"
                                Caption="@L["Doğum Tarihi"]">
                    <DisplayTemplate>
                        @context.Ogrenci_DogumTarihi.ToShortDateString()
                    </DisplayTemplate>
                </DataGridColumn>

                <!-- Sınıf -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.Ogrenci_Sinifi)"
                                Caption="@L["Sınıf"]" />

                <!-- Şube -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.Ogrenci_Subesi)"
                                Caption="@L["Şube"]" />

                <!-- Numara -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.Numarasi)"
                                Caption="@L["Numarası"]" />

                <!-- Oluşturulma Zamanı -->
                <DataGridColumn TItem="OgrenciDto"
                                Field="@nameof(OgrenciDto.CreationTime)"
                                Caption="@L["Oluşturulma Zamanı"]">
                    <DisplayTemplate>
                        @context.CreationTime.ToLongDateString()
                    </DisplayTemplate>
                </DataGridColumn>

                <DataGridEntityActionsColumn TItem="OgrenciDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="OgrenciDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="OgrenciDto"
                                          Text="@L["Güncelle"]"
                                          Visible=HasUpdatePermission
                                          Clicked="() => OpenEditModalAsync(context)" />
                            <EntityAction TItem="OgrenciDto"
                                          Text="@L["Sil"]"
                                          Visible=HasDeletePermission
                                          Clicked="() => DeleteEntityAsync(context)"
                                          ConfirmationMessage="()=>GetDeleteConfirmationMessage(context)" />
                        </EntityActions>

                    </DisplayTemplate>
                </DataGridEntityActionsColumn>


            </DataGridColumns>

        </DataGrid>
    </CardBody>
</Card>

<CardHeader>
    <Row Class="justify-content-between">
        <Column ColumnSize="ColumnSize.IsAuto">
            @if (HasCreatePermission)
            {
                <Button Color="Color.Primary"
                        Clicked="OpenCreateModalAsync">
                    @L["Yeni Öğrenci"]
                </Button>
            }

        </Column>
    </Row>
</CardHeader>
<Modal @ref="@CreateModal">
    <ModalBackdrop />
    <ModalContent IsCentered="true">
        <Form OnValidSubmit="CreateEntityAsync">
            <ModalHeader>
                <ModalTitle>@L["Yeni Öğrenci"]</ModalTitle>
                <CloseButton Clicked="CloseCreateModalAsync" />
            </ModalHeader>

            <ModalBody>
                <Validations @ref="@CreateValidationsRef"
                             Model="@NewEntity"
                             ValidateOnLoad="false">

                    <Validation MessageLocalizer="@((message, _) => L[message])">
                        <Field>
                            <FieldLabel>@L["Adı-Soyadı"]</FieldLabel>
                            <TextEdit @bind-Text="@NewEntity.Ogrenci_AdiSoyadi">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>

                    <Field>
                        <FieldLabel>@L["Bölüm"]</FieldLabel>
                        <Select TValue="Bolum"
                                @bind-SelectedValue="@NewEntity.Ogrenci_Bolumu">
                            @foreach (int bolumTypeValue in Enum.GetValues(typeof(Bolum)))
                            {
                                <SelectItem TValue="Bolum" Value="@((Bolum)bolumTypeValue)">
                                    @L[$"Enum:Bolum.{bolumTypeValue}"]
                                </SelectItem>
                            }
                        </Select>
                    </Field>

                    <Field>
                        <FieldLabel>@L["Sınıfı"]</FieldLabel>
                          <TextEdit @bind-Text="@NewEntity.Ogrenci_Sinifi">
                              <Feedback>

                                  <ValidationError />
                              </Feedback>

                          </TextEdit>

                    </Field>

                    <Field>
                        <FieldLabel>@L["Şubesi"]</FieldLabel>
                        <TextEdit @bind-Text="@NewEntity.Ogrenci_Subesi">
                            <Feedback>

                                <ValidationError />
                            </Feedback>

                        </TextEdit>

                    </Field>


                    <Field>
                        <FieldLabel>@L["Doğum Tarihi"]</FieldLabel>
                        <DateEdit TValue="DateTime"
                                  @bind-Date="NewEntity.Ogrenci_DogumTarihi" />
                    </Field>

                    <Field>
                        <FieldLabel>@L["Numarası"]</FieldLabel>
                        <NumericEdit TValue="int"
                                     @bind-Value="NewEntity.Numarasi" />
                    </Field>
                </Validations>
            </ModalBody>

            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateModalAsync">
                    @L["Cancel"]
                </Button>
                <Button Color="Color.Primary"
                        Type="@ButtonType.Submit"
                        PreventDefaultOnSubmit="true"
                        Clicked="CreateEntityAsync">
                    @L["Save"]
                </Button>
            </ModalFooter>

        </Form>
    </ModalContent>
</Modal>

<Modal @ref="@EditModal">
    <ModalBackdrop />
    <ModalContent IsCentered="true">
        <Form>
            <ModalHeader>
                <ModalTitle>@EditingEntity.Ogrenci_AdiSoyadi</ModalTitle>
                <CloseButton Clicked="CloseEditModalAsync"/>
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditValidationsRef" Model="@NewEntity" ValidateOnLoad="false">
                    <Validation MessageLocalizer="@((message, _) => L[message])">
                        <Field>
                            <FieldLabel>@L["Adı-Soyadı"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingEntity.Ogrenci_AdiSoyadi">
                                <Feedback>
                                    <ValidationError/>
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Field>
                        <FieldLabel>@L["Bölüm"]</FieldLabel>
                        <Select TValue="Bolum" @bind-SelectedValue="@EditingEntity.Ogrenci_Bolumu">
                            @foreach (int bolumTypeValue in Enum.GetValues(typeof(Bolum)))
                            {
                                <SelectItem TValue="Bolum" Value="@((Bolum)bolumTypeValue)">
                                    @L[$"Enum:Bolum.{bolumTypeValue}"]
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                    <Field>
                        <FieldLabel>@L["Doğum Tarihi"]</FieldLabel>
                        <DateEdit TValue="DateTime" @bind-Date="EditingEntity.Ogrenci_DogumTarihi"/>
                    </Field>
                    <Field>
                        <FieldLabel>@L["Numarası"]</FieldLabel>
                        <NumericEdit TValue="int" @bind-Value="EditingEntity.Numarasi"/>
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditModalAsync">@L["İptal"]</Button>
                <Button Color="Color.Primary"
                        Type="@ButtonType.Submit"
                        PreventDefaultOnSubmit="true"
                        Clicked="UpdateEntityAsync">@L["Kayıt"]</Button>
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@code
{
    public Ogrenciler() // Constructor
    {
        LocalizationResource = typeof(OkulApplicationResource);

        CreatePolicyName = OkulApplicationPermissions.Ogrenciler.Create;
        UpdatePolicyName = OkulApplicationPermissions.Ogrenciler.Edit;
        DeletePolicyName = OkulApplicationPermissions.Ogrenciler.Delete;
    }
}
