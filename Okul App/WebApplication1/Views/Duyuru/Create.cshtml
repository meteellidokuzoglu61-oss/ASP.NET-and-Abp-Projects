@model OgrenciApp.Models.Duyuru

<h2 class="text-black fs-5">Duyuru Ekleme</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Baslik" class="form-label">Duyurunun Başlığını Giriniz</label>
        <input asp-for="Baslik" class="form-control" maxlength="50" id="Baslik" />
        <small id="BaslikSayac" class="text-muted">0/50</small>
        <span asp-validation-for="Baslik" class="text-danger"></span>
    </div>

    <script>
        const baslikInput = document.getElementById("Baslik");
        const baslikSayac = document.getElementById("BaslikSayac");

        baslikInput.addEventListener("input", () => {
            baslikSayac.textContent = `${baslikInput.value.length}/50`;
        });
    </script>

    <div class="mb-3">
        <label asp-for="Icerik" class="form-label">Duyurunuzun Kategorisini Seçiniz</label>
        <select asp-for="Icerik" class="form-select">
            <option value="">Seçiniz...</option>
            <option value="Haber">Haber</option>
            <option value="Etkinlik">Etkinlik</option>
            <option value="Aktüel">Aktüel</option>
            <option value="Uluslararası">Uluslararası</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Ekle</button>
    <form asp-action="Ekle" asp-controller="Duyuru" enctype="multipart/form-data" method="post">

        <div class="form-group">
            <label>Başlık</label>
            <input type="text" class="form-control" asp-for="Baslik" />
        </div>

        <div class="form-group mt-2">
            <label>İçerik</label>
            <textarea class="form-control" asp-for="Icerik"></textarea>
        </div>

        <div class="form-group mt-2">
            <label>Fotoğraf Seç</label>
            <input type="file" name="foto" class="form-control" />
        </div>

        <button class="btn btn-primary mt-3">Kaydet</button>

    </form>



</form>
