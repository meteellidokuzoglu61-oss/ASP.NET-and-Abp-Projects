@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Okul Yönetim Sistemi </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Optional Styles section -->
    @RenderSection("Styles", required: false)
</head>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container d-flex justify-content-center">
            <ul class="navbar-nav d-flex flex-row">

                <li class="nav-item">
                  <a class="nav-link" asp-controller="Home" asp-action="Tarihce">Tarihçe</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="DevamsizlikIndex">Devamsızlık Listesi</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="BosKontenjanDetay" asp-route-bolumId="1">Boş Kontenjan</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="NotIndex">Not Girişi</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-light" href="/Home/Hakkimizda">Hakkımızda</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Saat" asp-action="Index">Okul Saatleri</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Home/Alanlarimiz">Alanlarımız</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Home/Kadromuz">Kadromuz</a>
                </li>
            </ul>
        </div>
    </nav>
</header>

<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Okul Uygulaması</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ogrenci" asp-action="Index">Öğrenci Listesi</a>
                        </li>

                        <!-- ✅ Etkinlikler Listesi linki -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Etkinlik" asp-action="Index">Etkinlikler</a>
                        </li>

                        <!-- ✅ Etkinlik Ekle linki -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Etkinlik" asp-action="Create">Etkinlik Ekle</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Setting" asp-action="Index">Ayarlar</a>
                        </li>

                        <li class="nav-item">
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm">Çıkış Yap</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <div class="container">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="border-top mt-4 py-3 text-center text-muted">
        &copy; 2025 - Ellidokuzoğlu Bilgi Teknolojileri AŞ
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Optional Scripts section -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
