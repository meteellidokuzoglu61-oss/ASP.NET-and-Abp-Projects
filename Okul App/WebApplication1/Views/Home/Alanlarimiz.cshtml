@{
    ViewBag.Title = "Alanlarımız";
    var departments = ViewBag.Departments;
}

<section id="alanlarimiz" class="container py-5">
    <h2 class="text-center mb-5">Alanlarımız</h2>

    <div class="accordion" id="departmentsAccordion">
        @for (int i = 0; i < departments.Length; i++)
        {
            var department = departments[i]; // ✔ ViewBag’den gelen veri
                                             <!-- ✔ DOĞRU KULLANIM -->

            <div class="accordion-item">
                <h2 class="accordion-header" id="heading@i">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@i" aria-expanded="false" aria-controls="collapse@i">
                        @department.Name
                    </button>
                </h2>

                <div id="collapse@i" class="accordion-collapse collapse" aria-labelledby="heading@i" data-bs-parent="#departmentsAccordion">
                    <div class="accordion-body text-center">
                        <img src="@department.ImageUrl" style="width:80px;height:80px;" alt="@department.Name" class="mb-3" />
                        <p>@department.Description</p>

                    </div><div class="mt-4">
                        <a href="@Url.Action("Index", "Alan")" class="btn btn-primary">
                            ← Tüm Alanlara Dön
                        </a>
                    </div>
                </div>
            </div>
        }
</section>
