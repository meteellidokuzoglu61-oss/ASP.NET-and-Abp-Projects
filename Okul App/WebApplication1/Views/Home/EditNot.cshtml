@model OgrenciApp.Models.Not

<h2>Not Düzenle</h2>

<form asp-action="EditNot" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-2">
        <label>Ders Id</label>
        <input type="number" class="form-control" asp-for="DersId" />
    </div>

    <div class="mb-2">
        <label>Öğrenci Id</label>
        <input type="number" class="form-control" asp-for="OgrenciId" />
    </div>

    <div class="mb-2">
        <label>Not</label>
        <input type="number" class="form-control" asp-for="Donem" />
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-action="NotIndex" class="btn btn-secondary">İptal</a>
</form>
