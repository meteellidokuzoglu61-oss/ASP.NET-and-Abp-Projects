@model WebApplication1.Models.Kullanici
@{

    ViewBag.Title = "Kayıt Ol";




}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" />

<div class="min-h-screen flex items-center justify-center bg-gray-50 p-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow p-6">
        <h2 class="text-2xl font-semibold mb-4 text-center">Yeni Hesap Oluştur</h2>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label class="block text-xs text-gray-600">Kullanıcı Adı</label>
                    @Html.TextBoxFor(m => m.Kullanici_Adi, new { @class = "mt-1 block w-full rounded-md border px-3 py-2 text-sm border-gray-200" })
                    @Html.ValidationMessageFor(m => m.Kullanici_Adi, "", new { @class = "text-xs text-red-500" })
                </div>

                <div>
                    <label class="block text-xs text-gray-600">Şifre</label>
                    @Html.PasswordFor(m => m.Kullanici_Sifresi, new { @class = "mt-1 block w-full rounded-md border px-3 py-2 text-sm border-gray-200" })
                    @Html.ValidationMessageFor(m => m.Kullanici_Sifresi, "", new { @class = "text-xs text-red-500" })
                </div>

                <button type="submit" class="w-full py-2 rounded-lg bg-indigo-600 text-white font-medium hover:brightness-105">Kayıt Ol</button>

                @Html.ValidationSummary(true, "", new { @class = "text-xs text-red-500 mt-2" })

                <div class="text-center text-xs text-gray-400 mt-2">
                    Zaten hesabın var mı? <a href="/Account/Login" class="text-indigo-600 hover:underline">Giriş Yap</a>
                </div>
            </div>
        }
    </div>
</div>
