@model IEnumerable<OgrenciApp.Models.Ogretmen>

@{
    ViewData["Title"] = "Öğretmen Listesi";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-3">
        <h2>Öğretmen Listesi</h2>
        <a asp-action="OgretmenCreate" class="btn btn-primary">Yeni Öğretmen Ekle</a>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ad Soyad</th>
                <th>Branş</th>
                <th>Doğum Tarihi</th>
                <th>Telefon</th>
                <th>Email</th>
                <th>Fotoğraf</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Id</td>
                    <td>@o.Ogretmen_AdiSoyadi</td>
                    <td>@o.Ogretmen_Bransi</td>
                    <td>@o.Ogretmen_DogumTarihi.ToString("yyyy-MM-dd")</td>
                    <td>@o.Ogretmen_Telefon</td>
                    <td>@o.Ogretmen_Emaili</td>
                    <td>
                        @if (!string.IsNullOrEmpty(o.Ogretmen_Fotografi))
                        {
                            <img src="@o.Ogretmen_Fotografi" alt="Fotoğraf" width="80" height="80" class="img-thumbnail" />
                        }
                        else
                        {
                            <span>Fotoğraf yok</span>
                        }
                    </td>
                    <td>
                        <a asp-action="OgretmenEdit" asp-route-id="@o.Id" class="btn btn-warning btn-sm">Düzenle</a>
                        <a asp-action="OgretmenDetails" asp-route-id="@o.Id" class="btn btn-info btn-sm">Detay</a>
                        <a asp-action="OgretmenDelete" asp-route-id="@o.Id" class="btn btn-danger btn-sm">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Styles {
    <style>
        .table-hover tbody tr:hover {
            background-color: #f2f2f2;
        }

        .btn-sm {
            margin-right: 2px;
        }
    </style>
}
