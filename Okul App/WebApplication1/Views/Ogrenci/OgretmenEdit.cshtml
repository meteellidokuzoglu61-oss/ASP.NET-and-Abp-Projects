@model OgrenciApp.Models.Ogretmen

@{
    ViewData["Title"] = "Öğretmen Düzenle";
}

<h2>Öğretmen Düzenle</h2>
<hr />

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Ad</label>
        <input asp-for="Ogretmen_AdiSoyadi" class="form-control" />
        <span asp-validation-for="Ogretmen_AdiSoyadi" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Branşı</label>
        <input asp-for="Ogretmen_Bransi" class="form-control" />
        <span asp-validation-for="Ogretmen_Bransi" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Doğum Tarihi</label>
        <input asp-for="Ogretmen_DogumTarihi" class="form-control" type="datetime" />
        <span asp-validation-for="Ogretmen_DogumTarihi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Telefon</label>
        <input asp-for="Ogretmen_Telefon" class="form-control" />
        <span asp-validation-for="Ogretmen_Telefon" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="Ogretmen_Emaili" class="form-control" />
        <span asp-validation-for="Ogretmen_Emaili" class="text-danger"></span>
    </div>


    <br />

    <button type="submit" class="btn btn-success">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>

</form>

<form method="post" enctype="multipart/form-data">

    @* Mevcut fotoğraf *@
    @if (!string.IsNullOrEmpty(Model.Ogretmen_Fotografi))
    {
        <img src="@Model.Ogretmen_Fotografi" style="width:150px;margin-bottom:10px;border-radius:8px;" />
    }

    <div class="mb-3">
        <label class="form-label">Yeni Fotoğraf (Değiştirmek istersen seç)</label>
        <input type="file" class="form-control" name="NewPhoto" />
    </div>

    <button class="btn btn-primary">Kaydet</button>
</form>
