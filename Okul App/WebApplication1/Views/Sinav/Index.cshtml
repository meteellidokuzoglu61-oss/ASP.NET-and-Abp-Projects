@model IEnumerable<Sinav>

@{
    ViewData["Title"] = "Sınav Takvimi";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Sınav Takvimi</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Ders</th>
                    <th>Tarih</th>
                    <th>Saat</th>
                    <th>Sınıf</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Ders</td>
                        <td>@s.Tarih.ToShortDateString()</td>
                        <td>@s.Saat</td>
                        <td>@s.Sinif</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-muted">Henüz sınav eklenmemiş.</p>
    }
</div>
