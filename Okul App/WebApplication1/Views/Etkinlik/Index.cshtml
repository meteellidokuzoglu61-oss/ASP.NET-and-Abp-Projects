@model IEnumerable<WebApplication1.Models.Etkinlik>


@{
    ViewBag.Title = "Etkinlikler";
}

<h2 class="text-center mb-4">Etkinlikler</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Ad</th>
            <th>Tarih</th>
            <th>Açıklama</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var etkinlik in Model)
        {
            <tr>
                <td>@etkinlik.Ad</td>
                <td>@etkinlik.Tarih.ToString("dd.MM.yyyy")</td>
                <td>@etkinlik.Aciklama</td>
            </tr>
        }
    </tbody>
</table>
